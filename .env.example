# Copy this file to .env and adjust values. Never commit .env.

# --- Database (used by docker compose and the API) ---
POSTGRES_USER=dtp
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=dhaka_tesla_pool
# Host port for Postgres (container port stays 5432).
POSTGRES_PORT=55432

# --- API ---
# Any random string of 16+ characters for local dev.
JWT_SECRET=local_dev_secret_change_me
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
# Where the frontend runs (for CORS).
CORS_ORIGIN=http://localhost:3000
# Host port for the API.
API_PORT=4000