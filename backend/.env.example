# Copy to backend/.env for local development. Never commit backend/.env.
# Matches the credentials in the root docker-compose.yml (host port 55432).
DATABASE_URL=postgres://dtp:change_me_local_only@localhost:55432/dhaka_tesla_pool

# Any random string of 16+ characters for local dev.
JWT_SECRET=local_dev_secret_change_me
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
# For running the test suite, create a second database and point tests at it via backend/.env.test:
# DATABASE_URL=postgres://dtp:change_me_local_only@localhost:55432/dhaka_tesla_pool_test